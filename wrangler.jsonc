{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bento-cms-buddy",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "no_bundle": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  }
}
